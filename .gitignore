# Rust
/target/
**/*.rs.bk

# 前端
node_modules
/dist
dist-ssr
*.local

# 日志
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Tauri 更新签名私钥。绝对不能提交 —— 泄露等于任何人都能给你的用户推送
# 一个"合法签名"的更新包。
*.key
/.tauri/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp
*.sw?

# 生成快照的脚本留下的字节码缓存
__pycache__/

# Local secrets, profiles and private test evidence must never be published.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
/.audit-tools/
/.agents/
/.codex/
/.aws/
/docs/audit/evidence/
/docs/ui/evidence/
/docs/v2/evidence/
# Historical workstation audit reports stay local; publish a curated report instead.
/docs/audit/
/docs/ui/
/docs/v2/*
!/docs/v2/Run-Check.ps1
!/docs/v2/tauri.smoke.conf.json
/playwright-report/
/test-results/
